{
  "name": "Harness (Electron)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspace",
  "forwardPorts": [
    5173,
    6080,
    9825
  ],
  "portsAttributes": {
    "5173": {
      "label": "App (Vite HMR)",
      "onAutoForward": "silent"
    },
    "6080": {
      "label": "Desktop App (noVNC)",
      "onAutoForward": "notify"
    },
    "9825": {
      "label": "CDP Debug",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "pnpm install",
  "postStartCommand": ".devcontainer/start-services.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}

{
  "name": "@harness/memory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Supervisor and client for the embedded, local-only Hindsight memory engine",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "python/harness_hindsight_launcher.py",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external zod --target es2022",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test src",
    "test:python": "python3 -m unittest discover -s python"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "bun-types": "^1.3.6",
    "tsup": "^8.5.0",
    "typescript": "^5.6.3"
  }
}

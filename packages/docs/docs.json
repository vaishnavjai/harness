{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Harness Docs",
  "favicon": "/logo/light.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "colors": {
    "primary": "#011627",
    "light": "#cbd5e1",
    "dark": "#011627"
  },
  "background": {
    "color": {
      "light": "#ffffff",
      "dark": "#011627"
    }
  },
  "seo": {
    "metatags": {
      "og:image": "https://github.com/vaishnavjai/harness/tree/dev/packages/docs",
      "og:image:alt": "Harness — Local Agent Desktop.",
      "twitter:image:alt": "Harness — Local Agent Desktop."
    }
  },
  "markdown": {
    "instructions": [
      "For agents: install the Harness desktop app from https://github.com/vaishnavjai/harness/releases. Do not run `npx harness`, `npm install harness`, or `brew install --cask harness`; packages with those names are different projects."
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Start here",
        "pages": [
          "start-here/get-started",
          "start-here/downloads",
          "start-here/migrate-from-claude-cowork",
          {
            "group": "Help improve Harness",
            "pages": [
              "start-here/missing-docs",
              "start-here/missing-languages"
            ]
          }
        ]
      },
      {
        "tab": "Desktop App",
        "pages": [
          {
            "group": "Get started",
            "pages": [
              "desktop-app/first-task"
            ]
          },
          {
            "group": "Connect services",
            "pages": [
              "start-here/connect-your-stack/add-an-mcp-server",
              "start-here/connect-your-stack/enable-exa-search"
            ]
          },
          {
            "group": "Skills",
            "pages": [
              "start-here/do-work-with-it/create-a-skill-from-chat",
              "start-here/do-work-with-it/skills-plugins-and-mcp"
            ]
          },
          {
            "group": "Models and providers",
            "pages": [
              "start-here/connect-your-stack/use-local-models",
              "start-here/connect-your-stack/add-anthropic-api-key",
              "start-here/connect-your-stack/add-a-custom-llm",
              "start-here/connect-your-stack/use-gemini-and-vertex-ai",
              "start-here/connect-your-stack/sign-in-with-chatgpt",
              "start-here/connect-your-stack/using-opencode-zen-go-models",
              "start-here/do-work-with-it/what-uses-tokens"
            ]
          },
          {
            "group": "Do work with it",
            "pages": [
              "start-here/do-work-with-it/control-the-browser",
              "start-here/do-work-with-it/use-desktop-apps",
              "start-here/do-work-with-it/cross-chat-memory",
              "start-here/do-work-with-it/work-with-excel-workbooks",
              "start-here/do-work-with-it/workflows"
            ]
          },
          {
            "group": "Network",
            "pages": [
              "start-here/outbound-network-access",
              "start-here/certificate-trust-and-proxies"
            ]
          }
        ]
      },
      {
        "tab": "Roadmap",
        "pages": [
          "roadmap"
        ]
      },
      {
        "tab": "Changelog",
        "pages": [
          "changelog"
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/start-here/get-started"
    },
    {
      "source": "/quickstart",
      "destination": "/start-here/get-started"
    },
    {
      "source": "/introduction",
      "destination": "/start-here/get-started"
    },
    {
      "source": "/roadmap/roadmap",
      "destination": "/roadmap"
    },
    {
      "source": "/changelog/changelog",
      "destination": "/changelog"
    },
    {
      "source": "/desktop-app",
      "destination": "/desktop-app/first-task"
    }
  ],
  "errors": {
    "404": {
      "redirect": false,
      "title": "Missing Documentation?",
      "description": "If you're technical and want to use a specific part of the app that is not documented well yet, [open an issue](https://github.com/vaishnavjai/harness/issues) and tell us what you're missing."
    }
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Download Harness",
      "href": "https://github.com/vaishnavjai/harness/releases"
    }
  }
}

{
  "name": "@harness/evals",
  "private": true,
  "type": "module",
  "scripts": {
    "test:pr": "vitest run --config vitest.config.ts --project pr",
    "test:pr:coverage": "vitest run --config vitest.config.ts --project pr --coverage.enabled=true --coverage.provider=v8 --coverage.reporter=text-summary --coverage.reporter=lcov --coverage.reportsDirectory=./coverage",
    "flake:collect": "node scripts/flake-report.mjs collect",
    "flake:report": "node scripts/flake-report.mjs report",
    "test:e2e": "vitest run --config vitest.config.ts --project e2e",
    "artifacts:index": "node packages/test-artifacts/bin/artifact-index.mjs",
    "artifacts:publish": "node packages/test-artifacts/bin/publish-pr.mjs",
    "evidence:judge": "node packages/test-evidence/bin/test-evidence-judge.mjs",
    "lint:layers": "depcruise --config .dependency-cruiser.cjs --ignore-known .dependency-cruiser-known-violations.json packages specs worlds bin runner scripts",
    "test": "pnpm run check:browser && pnpm run lint:layers && node scripts/spec-channel-ratchet.mjs && node scripts/spec-boundary-ratchet.mjs && node --test runner/*.test.ts packages/*/test/*.test.ts bin/*.test.mjs scripts/*.test.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "typecheck:spec-layer": "tsc -p tsconfig.primitives.json",
    "test:core": "vitest run --config vitest.config.ts --project pr specs/thread-approvals-replay.test.ts specs/effective-permissions-attribution.test.ts specs/pdf-attachments-model-routing.test.ts specs/route-session-list.test.ts",
    "check:browser": "node scripts/check-browser-code.mjs"
  },
  "dependencies": {
    "@harness/behaviors": "workspace:*",
    "@harness/cdp": "workspace:*",
    "@harness/env": "workspace:*",
    "@harness/hosts": "workspace:*",
    "@harness/labs": "workspace:*",
    "@harness/matchers": "workspace:*",
    "@harness/review": "link:../packages/review",
    "@harness/test-artifacts": "workspace:*",
    "@harness/test-evidence": "workspace:*",
    "@harness/testkit": "workspace:*",
    "@harness/types": "link:../packages/types",
    "@harness/world": "link:../packages/world"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "18.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "xml-crypto": "6.1.2"
  },
  "packageManager": "pnpm@11.4.0"
}

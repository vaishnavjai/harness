{
  "name": "@harness/workspace",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "package": "node scripts/package.mjs",
    "test:packaging": "node --test scripts/package.test.mjs scripts/hindsight/staged-python.test.mjs scripts/licenses/aggregate-licenses.test.mjs scripts/smoke/packaged-app-smoke.test.mjs",
    "smoke:packaged": "node scripts/smoke/packaged-app-smoke.mjs",
    "dev": "HARNESS_DEV_MODE=1 HARNESS_ELECTRON_REMOTE_DEBUG_PORT=${HARNESS_ELECTRON_REMOTE_DEBUG_PORT:-9823} pnpm --filter @harness/desktop dev",
    "dev:worktree": "HARNESS_DEV_MODE=1 HARNESS_DEV_PROFILE=auto HARNESS_ELECTRON_USE_MOCK_KEYCHAIN=${HARNESS_ELECTRON_USE_MOCK_KEYCHAIN:-1} HARNESS_ELECTRON_REMOTE_DEBUG_PORT=0 PORT=0 pnpm --filter @harness/desktop dev",
    "dev:electron": "HARNESS_DEV_MODE=1 pnpm --filter @harness/desktop dev:electron",
    "dev:sandbox": "bash .devcontainer/dev-sandbox.sh",
    "dev:ui": "HARNESS_DEV_MODE=1 pnpm --filter @harness/app dev",
    "dev:ui-demo": "pnpm --filter @harness/ui-demo dev",
    "dev:headless-web": "HARNESS_DEV_MODE=1 node scripts/dev-headless-web.ts",
    "build": "node scripts/build.mjs",
    "build:ui": "pnpm --filter @harness/app build",
    "preview": "pnpm --filter @harness/app preview",
    "typecheck": "pnpm --filter @harness/app typecheck",
    "check:enterprise-mcp-mock-server": "pnpm --filter @harness/enterprise-mcp-mock-server check",
    "test": "pnpm test:core",
    "test:health": "pnpm --filter @harness/app test:health",
    "test:sessions": "pnpm --filter @harness/app test:sessions",
    "test:refactor": "pnpm --filter @harness/app test:refactor",
    "test:events": "pnpm --filter @harness/app test:events",
    "test:todos": "pnpm --filter @harness/app test:todos",
    "test:permissions": "pnpm --filter @harness/app test:permissions",
    "test:session-error-recovery": "pnpm --filter @harness/app test:session-error-recovery",
    "test:session-scope": "pnpm --filter @harness/app test:session-scope",
    "test:session-switch": "pnpm --filter @harness/app test:session-switch",
    "test:fs-engine": "pnpm --filter @harness/app test:fs-engine",
    "test:eval-runner": "pnpm --dir evals run test",
    "warden:check": "pnpm dlx @sentry/warden@0.43.0 --runtime pi --config-path warden.toml --log",
    "check:outbound-access": "node scripts/check-outbound-access.mjs",
    "test:e2e": "pnpm --filter @harness/app test:e2e",
    "evals:e2e": "node evals/bin/evals.mjs",
    "evals:parity": "node evals/scripts/engine-parity.mjs",
    "evals:typecheck": "pnpm --dir evals typecheck",
    "evals:test": "pnpm --dir evals test",
    "evals:pr": "pnpm --dir evals run test:pr",
    "world": "node evals/bin/world.mjs",
    "release:review": "node scripts/release/review.mjs",
    "release:rollback": "node scripts/release/rollback.mjs",
    "release:cut": "node scripts/release/cut.mjs",
    "release:cut:watch": "node scripts/release/cut.mjs --watch",
    "test:core": "pnpm --filter @harness/app test:core && pnpm --filter @harness/server test:core && pnpm --filter @harness/desktop test:core && pnpm --dir evals run test:core",
    "test:extended": "pnpm --filter @harness/app test && pnpm --filter @harness/server test && pnpm --filter @harness/desktop test && node --test scripts/release/*.test.mjs && pnpm test:eval-runner && pnpm evals:pr && pnpm test:e2e",
    "evals:check-browser": "pnpm --dir evals check:browser"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "turbo": "^2.10.7",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@11.4.0"
}
